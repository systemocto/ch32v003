// Statusvariabelen voor de I2C state-machine
//volatile uint8_t i2c_reg_pointer = 0;   // Wijst naar het huidige virtuele EEPROM-adres
//volatile uint8_t i2c_first_byte = 1;    // Geeft aan of de master net is gestart (voor de pointer)

void Pure_Hardware_I2C_Slave_Init(void) {
    GPIO_InitTypeDef GPIO_InitStructure = {0};
    I2C_InitTypeDef  I2C_InitTSturcture = {0};

    // 1. Schakel de klokken in via de MounRiver SPL (GPIOC, I2C1 en AFIO)
    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOC | RCC_APB2Periph_AFIO, ENABLE);
    RCC_APB1PeriphClockCmd(RCC_APB1Periph_I2C1, ENABLE);

    // 2. Configureer PC1 (SDA) en PC2 (SCL) als Alternate Function Open-Drain
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_1 | GPIO_Pin_2;
    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_AF_OD; 
    GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_Init(GPIOC, &GPIO_InitStructure);

    // 3. Reset de hardware module om alle interne registers te cleanen
    I2C1->CTLR1 |= I2C_CTLR1_SWRST;             
    I2C1->CTLR1 &= ~I2C_CTLR1_SWRST;

    // 4. Configureer de hardware registers
    I2C_InitTSturcture.I2C_ClockSpeed = 100000; // 100kHz standaard snelheid
    I2C_InitTSturcture.I2C_Mode = I2C_Mode_I2C; 
    I2C_InitTSturcture.I2C_DutyCycle = I2C_DutyCycle_2; 
    I2C_InitTSturcture.I2C_OwnAddress1 = (I2C_SLAVE_ADDRESS << 1); // 7-bit adres verschuiven
    I2C_InitTSturcture.I2C_Ack = I2C_Ack_Enable; 
    I2C_InitTSturcture.I2C_AcknowledgedAddress = I2C_AcknowledgedAddress_7bit; 
    I2C_Init(I2C1, &I2C_InitTSturcture);

    I2C1->CTLR1 |= I2C_CTLR1_NOSTRETCH;

    // 5. Schakel de I2C module definitief in
    I2C_Cmd(I2C1, ENABLE);
}

void I2C1_EV_IRQHandler(void) __attribute__((interrupt("WCH-Interrupt-fast")));

void I2C1_EV_IRQHandler(void) {
    uint32_t star1 = I2C1->STAR1; // Sla STAR1 op om de actieve vlaggen te controleren

    // =========================================================================
    // 1. ADDR EVENT: De PCIe-kaart heeft ons slave-adres (0x30) aangeroepen
    // =========================================================================
    if (star1 & I2C_STAR1_ADDR) {
        i2c_address_state = 0; // Reset de adres-state (Verwacht High Byte)
        
        // WCH SPECIFIEK: Het lezen van STAR1 (hierboven) GEVOLGD door het lezen van STAR2
        // wist de ADDR-vlag in de hardware en geeft de SCL-lijn direct weer vrij!
        volatile uint32_t star2 = I2C1->STAR2; 
        (void)star2; // Voorkom compiler-waarschuwing voor ongebruikte variabele

        // Leg direct data klaar voor een eventuele directe "Current Address Read"
        if (i2c_reg_pointer == 0x00F0) {
            I2C1->DATAR = bulk_buffer_index;
        } else if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
            I2C1->DATAR = i2c_config_regs[i2c_reg_pointer];
        } else {
            I2C1->DATAR = 0x00;
        }
        return; // Verlaat interrupt, SCL is weer vrij!
    }

    // =========================================================================
    // 2. RXNE EVENT: De PCIe-kaart schrijft data (16-bit Adres OF Register data)
    // =========================================================================
    if (star1 & I2C_STAR1_RXNE) {
        uint8_t received_byte = I2C1->DATAR; // Het lezen wist de RXNE-vlag automatisch

        if (i2c_address_state == 0) {
            // Stap A: Dit is de HIGH BYTE van het 16-bit adres
            i2c_reg_pointer = ((uint16_t)(received_byte & 0x0F) << 8);
            i2c_address_state = 1; // Volgende byte wordt de Low Byte
        } 
        else if (i2c_address_state == 1) {
            // Stap B: Dit is de LOW BYTE van het 16-bit adres
            i2c_reg_pointer |= received_byte;
            i2c_reg_pointer %= VIRTUELE_SIZE_AT24C32; // Failsafe begrenzing (4096)
            i2c_address_state = 2; // Adres is compleet, volgende bytes zijn echte data
        } 
        else {
            // Stap C: DATA FASE (De PCIe kaart schrijft data naar de MCU)
            if (i2c_reg_pointer == 0x00F3) {
                uint8_t handshaked_buf = received_byte;
                if (handshaked_buf == buffer_klaar_voor_linux && handshaked_buf != 0xFF) {
                    nmea_write_ptr[handshaked_buf] = 0;
                    nmea_read_ptr[handshaked_buf] = 0;
                    buffer_klaar_voor_linux = 0xFF;
                    bulk_buffer_index = 0xFF;
                    bulk_buffer_lengte = 0;
                }
            }
            else if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
                // Bescherm de configuratieregisters (LTC, IRIG-B, Klok)
                if (i2c_reg_pointer == 0x01 || i2c_reg_pointer == 0x02 || i2c_reg_pointer == 0x03 ||
                    i2c_reg_pointer == 0x04 || i2c_reg_pointer == 0x05 || i2c_reg_pointer == 0x06 ||
                    i2c_reg_pointer == 0x10 || i2c_reg_pointer == 0x11 || i2c_reg_pointer == 0x12 ||
                    i2c_reg_pointer == 0x14 || i2c_reg_pointer == 0x15 || i2c_reg_pointer == 0x16 ||
                    i2c_reg_pointer == 0x17) {
                    
                    i2c_config_regs[i2c_reg_pointer] = received_byte;
                }
            }
            i2c_reg_pointer = (i2c_reg_pointer + 1) % VIRTUELE_SIZE_AT24C32;
        }
        return;
    }

    // =========================================================================
    // 3. TXE EVENT: De PCIe-kaart leest opeenvolgende data (Sequential Read)
    // =========================================================================
    if (star1 & I2C_STAR1_TXE) {
        if (i2c_reg_pointer == 0x00F0) {
            I2C1->DATAR = bulk_buffer_index;
        }
        else if (i2c_reg_pointer == 0x00F1) {
            I2C1->DATAR = (uint8_t)((bulk_buffer_lengte >> 8) & 0xFF);
        }
        else if (i2c_reg_pointer == 0x00F2) {
            I2C1->DATAR = (uint8_t)(bulk_buffer_lengte & 0xFF);
        }
        else if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
            I2C1->DATAR = i2c_config_regs[i2c_reg_pointer];
        } 
        else if (i2c_reg_pointer >= NMEA_VIRTUEEL_START && i2c_reg_pointer < (NMEA_VIRTUEEL_START + NMEA_BUFFER_SIZE)) {
            if (buffer_klaar_voor_linux != 0xFF) {
                uint16_t lees_index = (buffer_klaar_voor_linux * BUFFER_SIZE_HALF) + nmea_read_ptr[buffer_klaar_voor_linux];
                I2C1->DATAR = nmea_transit_buffer[lees_index];
                nmea_read_ptr[buffer_klaar_voor_linux]++;
            } else {
                I2C1->DATAR = 0x00;
            }
        } 
        else {
            I2C1->DATAR = 0x00;
        }
        i2c_reg_pointer = (i2c_reg_pointer + 1) % VIRTUELE_SIZE_AT24C32;
        return;
    }

    // =========================================================================
    // 4. STOPF EVENT: De PCIe-kaart sluit de transactie af met een STOP
    // =========================================================================
    if (star1 & I2C_STAR1_STOPF) {
        I2C1->CTLR1 = I2C1->CTLR1; // Wis de STOPF-vlag door CTLR1 naar zichzelf terug te schrijven
    }
}


void I2C_EEPROM_VerwerkPolling(void) {
    uint32_t star1 = I2C1->STAR1;
    // 1. ADDR Vlag: De Pi start een transactie
    if (star1 & I2C_STAR1_ADDR) {
        i2c_address_state = 0; // Verwacht High Byte van het adres
        
        volatile uint32_t star2 = I2C1->STAR2; // Wis ADDR vlag
        (void)star2;
        
        // Data klaarzetten voor directe lees-actie (Current Address Read)
        if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
            I2C1->DATAR = i2c_config_regs[i2c_reg_pointer];
        } 
        else if (i2c_reg_pointer >= NMEA_VIRTUEEL_START && i2c_reg_pointer < (NMEA_VIRTUEEL_START + NMEA_BUFFER_SIZE)) {
            I2C1->DATAR = nmea_transit_buffer[i2c_reg_pointer - NMEA_VIRTUEEL_START];
        } 
        else {
            I2C1->DATAR = 0x00;
        }
    }

    // 2. RXNE Vlag: De Pi stuurt data (Adres bytes of Schrijf-data)
    if (star1 & I2C_STAR1_RXNE) {
        uint8_t received_byte = I2C1->DATAR; // Lezen wist de RXNE vlag

        if (i2c_address_state == 0) {
            // Stap A: High Byte van het 16-bit adres
            i2c_reg_pointer = ((uint16_t)(received_byte & 0x0F) << 8);
            i2c_address_state = 1;
        } 
        else if (i2c_address_state == 1) {
            // Stap B: Low Byte van het 16-bit adres
            i2c_reg_pointer |= received_byte;
            i2c_reg_pointer %= VIRTUELE_SIZE_AT24C32; // Begrens strikt op 4096 bytes (AT24C32)
            i2c_address_state = 2; // Statemachine is nu klaar voor DATA
        } 
        else {
            // Stap C: DATA FASE (De Pi schrijft daadwerkelijk een byte naar ons)
            
            // 1. VANG DE HANDSHAKE OP OP VIRTUEEL ADRES 0x00F3
            if (i2c_reg_pointer == 0x00F3) {
                uint8_t handshaked_buf = received_byte; 
                
                // Controleer of de Pi de juiste buffer probeert vrij te geven
                if (handshaked_buf == buffer_klaar_voor_linux && handshaked_buf != 0xFF) {
                    nmea_write_ptr[handshaked_buf] = 0; // Reset de UART schrijf-pointer voor deze helft!
                    nmea_read_ptr[handshaked_buf] = 0;  // Reset de I2C lees-pointer voor deze helft!
                    buffer_klaar_voor_linux = 0xFF;     // Zet de status weer op 'wachtend'
                    bulk_buffer_index = 0xFF;           // Reset het statusregister voor de Pi
                    bulk_buffer_lengte = 0;             // Reset de lengte voor de Pi
                }
            }
            // 2. JOUW REGULIERE EN VEILIGE INSTELLINGEN (Alleen schrijven naar de 128 config bytes)
            else if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
                // Jouw specifieke register-beveiliging filter:
                if (i2c_reg_pointer == 0x01 || i2c_reg_pointer == 0x02 || i2c_reg_pointer == 0x03 ||
                    i2c_reg_pointer == 0x04 || i2c_reg_pointer == 0x05 || i2c_reg_pointer == 0x06 ||
                    i2c_reg_pointer == 0x10 || i2c_reg_pointer == 0x11 || i2c_reg_pointer == 0x12 ||
                    i2c_reg_pointer == 0x14 || i2c_reg_pointer == 0x15 || i2c_reg_pointer == 0x16 ||
                    i2c_reg_pointer == 0x17) {
                    
                    i2c_config_regs[i2c_reg_pointer] = received_byte; 
                }
            }
            
            // Hoog de pointer virtueel op (belangrijk voor opeenvolgende schrijf-acties/page writes)
            i2c_reg_pointer = (i2c_reg_pointer + 1) % VIRTUELE_SIZE_AT24C32;
        }
    }

    // 3. TXE Vlag: De Pi leest opeenvolgende bytes (Sequential Read)
    // Dit is waar de magie gebeurt als de Pi in één keer de 1200 bytes NMEA leest!
    if (star1 & I2C_STAR1_TXE) {
        // A. VIRTUELE BULK STATUS REGISTERS (0x00F0 t/m 0x00F2)
        if (i2c_reg_pointer == 0x00F0) {
            I2C1->DATAR = bulk_buffer_index;
        }
        else if (i2c_reg_pointer == 0x00F1) {
            I2C1->DATAR = (uint8_t)((bulk_buffer_lengte >> 8) & 0xFF);
        }
        else if (i2c_reg_pointer == 0x00F2) {
            I2C1->DATAR = (uint8_t)(bulk_buffer_lengte & 0xFF);
        }
        // B. JOUW REGULIERE INSTELLINGEN (Inclusief LTC, IRIG-B en BCD-tijd)
        else if (i2c_reg_pointer < CONFIG_REGISTERS_SIZE) {
            I2C1->DATAR = i2c_config_regs[i2c_reg_pointer];
        } 
        // C. DE 1500 BYTES BULK BUFFER VANAF VIRTUEEL ADRES 0x0100
        else if (i2c_reg_pointer >= NMEA_VIRTUEEL_START && i2c_reg_pointer < (NMEA_VIRTUEEL_START + NMEA_BUFFER_SIZE)) {
            if (buffer_klaar_voor_linux != 0xFF) {
                uint16_t lees_index = (buffer_klaar_voor_linux * BUFFER_SIZE_HALF) + nmea_read_ptr[buffer_klaar_voor_linux];
                I2C1->DATAR = nmea_transit_buffer[lees_index];
                nmea_read_ptr[buffer_klaar_voor_linux]++;
            } else {
                I2C1->DATAR = 0x00; 
            }
        } 
        else {
            I2C1->DATAR = 0x00;
        }
        i2c_reg_pointer = (i2c_reg_pointer + 1) % VIRTUELE_SIZE_AT24C32;
    }

    // 4 & 5. Stop en Foutafhandeling
    if (star1 & I2C_STAR1_STOPF) {
        I2C1->CTLR1 = I2C1->CTLR1;
    }
    if (star1 & (I2C_STAR1_BERR | I2C_STAR1_AF)) {
        I2C1->STAR1 &= ~(I2C_STAR1_BERR | I2C_STAR1_AF);
    }
}


// Schaduw-buffer voor de I2C-tijdregisters
static uint8_t i2c_tijd_shadow[7] = {0};


/* Set date/time BCD
 * # Set de tijd naar 16:45:00 28 jun 2026 via BCD-registers
 * i2cset -y 1 0x30 0x10 0x16 0x45 0x00 0x00 0x28 0x06 0x26 i
 */
void I2C_EEPROM_SynchroniseerTijd(void) {
        if (i2c_config_regs[0x12] != i2c_tijd_shadow[2] || 
            i2c_config_regs[0x11] != i2c_tijd_shadow[1] || 
            i2c_config_regs[0x10] != i2c_tijd_shadow[0]) {
            
            // De Pi heeft overduidelijk nieuwe waarden gestuurd! Neem ze atomair over
            __disable_irq();
            interne_uren     = BCD_TO_DEC(i2c_config_regs[0x10]);
            interne_minuten  = BCD_TO_DEC(i2c_config_regs[0x11]);
            interne_seconden = BCD_TO_DEC(i2c_config_regs[0x12]);
            interne_dag      = BCD_TO_DEC(i2c_config_regs[0x14]);
            interne_maand    = BCD_TO_DEC(i2c_config_regs[0x15]);
            interne_jaar     = BCD_TO_DEC(i2c_config_regs[0x16]);
            __enable_irq();

            // Update direct de schaduw-buffer naar de nieuwe werkelijkheid
            i2c_tijd_shadow[0] = i2c_config_regs[0x10];
            i2c_tijd_shadow[1] = i2c_config_regs[0x11];
            i2c_tijd_shadow[2] = i2c_config_regs[0x12];
            i2c_tijd_shadow[4] = i2c_config_regs[0x14];
            i2c_tijd_shadow[5] = i2c_config_regs[0x15];
            i2c_tijd_shadow[6] = i2c_config_regs[0x16];
        } 
        else {
            i2c_config_regs[0x16] = i2c_tijd_shadow[6] = DEC_TO_BCD(interne_jaar);
            i2c_config_regs[0x15] = i2c_tijd_shadow[5] = DEC_TO_BCD(interne_maand);
            i2c_config_regs[0x14] = i2c_tijd_shadow[4] = DEC_TO_BCD(interne_dag);
            
            i2c_config_regs[0x12] = i2c_tijd_shadow[2] = DEC_TO_BCD(interne_seconden);
            i2c_config_regs[0x11] = i2c_tijd_shadow[1] = DEC_TO_BCD(interne_minuten);
            i2c_config_regs[0x10] = i2c_tijd_shadow[0] = DEC_TO_BCD(interne_uren);
        }
}

void I2C_EEPROM_VulTestpatroon(void) {
    for (uint16_t i = 0; i < CONFIG_REGISTERS_SIZE; i++) i2c_config_regs[i] = (uint8_t)i; 

}

void Flash_BlankCheck_Init(void) {
    uint8_t *flash_ptr = (uint8_t*)FLASH_EEPROM_PAGE_ADDR;
    uint8_t is_blank = 1;

#ifndef  BLANKFLASH
    // 1. Controleer of de eerste 32 bytes van de Flash-pagina volledig leeg (0xFF) zijn
    for (int i = 0; i < 32; i++) {
        if (flash_ptr[i] != 0xFF) {
            is_blank = 0; // Er staat al data in de flash!
            break;
        }
    }
#endif

    // 2. Als de Flash leeg is, laad fabrieksinstellingen (defaults) in RAM en sla ze op
    if (is_blank) {
        // Wis eerst de gehele array naar 0
        for (int i = 0; i < CONFIG_REGISTERS_SIZE; i++) {
            i2c_config_regs[i] = 0x00;
        }

        // Specifieke default waarden toewijzen volgens onze EEPROM map:
        i2c_config_regs[0x00] = 0x00; // Systeem Status error flags 0x00:OK, 0x01:NMEA port, 0x02:clocksource, 0x80:fw/driver/software
        i2c_config_regs[0x01] = 0x01; // Max helderheid display (TM1652)
        i2c_config_regs[0x02] = 0x00; // Flash schrijf interval standaard UIT (0), 2^ 13 = 8192 seconds, 0x11 17 = write now
        i2c_config_regs[0x03] = 0x00; // default baudrate index 0=115200 baud
        i2c_config_regs[0x04] = 0x05; // baudrate autodetect timeout * 1.5s. 0=blijf testen, 0xff=default baudrate
        i2c_config_regs[0x05] = 0x00; // display modus. 0:time, 1:date, 2:GNSS, 3:PPM
        i2c_config_regs[0x06] = 127; // LTC Frame Offset = 0 frames
        i2c_config_regs[0x07] = 127; // IRIG-B ms Offset = 0 ms
        i2c_config_regs[0x17] = 0x00; // Tijdzone UTC

        // Sla deze fabrieksinstellingen direct permanent op in de Flash
        // Zodat bij de volgende boot de pagina niet meer als 'blank' wordt gezien
//        Flash_Save_EEPROM_Page();
    } 
    // 3. Als de Flash al geconfigureerde data bevat, laad deze in de RAM-array
    else {
        for (int i = 0; i < 32; i++) {
            i2c_config_regs[i] = flash_ptr[i];
        }
    }

    // Synchroniseer de schaduw-buffer met de zojuist geladen EEPROM-startwaarden
    i2c_tijd_shadow[2] = i2c_config_regs[0x12]; // seconden
    i2c_tijd_shadow[1] = i2c_config_regs[0x11]; // minuten
    i2c_tijd_shadow[0] = i2c_config_regs[0x10]; // uren
    i2c_tijd_shadow[4] = i2c_config_regs[0x14]; // dag
    i2c_tijd_shadow[5] = i2c_config_regs[0x15]; // maand
    i2c_tijd_shadow[6] = i2c_config_regs[0x16]; // jaar


}


// Hulpfunctie om 1 byte naar een specifiek register van de PCF9557 te schrijven
void PCF9557_WriteRegister(uint8_t reg, uint8_t value) {
    // 1. Wacht tot de bus vrij is
    while(I2C1->STAR2 & I2C_STAR2_BUSY);

    // 2. Genereer START conditie
    I2C1->CTLR1 |= I2C_CTLR1_START;
    while(!(I2C1->STAR1 & I2C_STAR1_SB)); // Wacht op Start Bit vlag

    // 3. Stuur PCF9557 adres + Write bit (0x18 << 1 = 0x30)
    // Let op: Omdat je eigen slave adres ook 0x30 is, moet de CH32 tijdelijk 
    // uit Slave-modus. I2C hardware handelt dit automatisch af als Master.
    I2C1->DATAR = (PCF9557_ADDRESS << 1);
    while(!(I2C1->STAR1 & I2C_STAR1_ADDR));
    (void)I2C1->STAR2; // Wis ADDR vlag

    // 4. Stuur het register-adres
    I2C1->DATAR = reg;
    while(!(I2C1->STAR1 & I2C_STAR1_TXE)); // Wacht tot buffer leeg is

    // 5. Stuur de data-waarde
    I2C1->DATAR = value;
    while(!(I2C1->STAR1 & I2C_STAR1_TXE));

    // 6. Genereer STOP conditie
    I2C1->CTLR1 |= I2C_CTLR1_STOP;
}

uint8_t PCF9557_LeesHogeBits(void) {
    uint8_t raw_input = 0;

    // 1. Wacht tot de bus vrij is
    while(I2C1->STAR2 & I2C_STAR2_BUSY);

    // 2. STAP 1: Selecteer register 0x00 (Input Port) via een Write-actie
    I2C1->CTLR1 |= I2C_CTLR1_START;
    while(!(I2C1->STAR1 & I2C_STAR1_SB)); // Wacht op Start Bit

    // Stuur adres + Write (0x18 << 1 = 0x30)
    I2C1->DATAR = (PCF9557_ADDRESS << 1);
    while(!(I2C1->STAR1 & I2C_STAR1_ADDR));
    (void)I2C1->STAR2; // Wis ADDR vlag

    // Stuur het register-adres 0x00 (Input Port)
    I2C1->DATAR = 0x00;
    while(!(I2C1->STAR1 & I2C_STAR1_TXE)); // Wacht tot buffer leeg is

    // 3. STAP 2: Schakel om naar Read-modus met een REPEATED START
    I2C1->CTLR1 |= I2C_CTLR1_START;
    while(!(I2C1->STAR1 & I2C_STAR1_SB));

    // Stuur adres + Read bit ( (0x18 << 1) | 1 = 0x31 )
    I2C1->DATAR = (PCF9557_ADDRESS << 1) | 1;
    while(!(I2C1->STAR1 & I2C_STAR1_ADDR));
    
    // Omdat we maar EEN enkele byte willen lezen, moeten we de ACK nu alvast 
    // uitschakelen (NACK) en de STOP-conditie klaarzetten VOORDAT we de ADDR-vlag wissen!
    I2C1->CTLR1 &= ~I2C_CTLR1_ACK; // Geef NACK na de eerste byte
    I2C1->CTLR1 |= I2C_CTLR1_STOP; // Genereer direct een STOP na de byte

    (void)I2C1->STAR2; // Wis de ADDR vlag, de hardware leest nu de byte in

    // Wacht tot de byte volledig binnen is in het dataregister (RXNE)
    while(!(I2C1->STAR1 & I2C_STAR1_RXNE));
    raw_input = I2C1->DATAR; // Lees de ruwe 8-bits waarde uit

    // Herstel de ACK-stand voor je eigen I2C Slave-modus
    I2C1->CTLR1 |= I2C_CTLR1_ACK;

    // 4. Filter en retourneer alleen de 4 hoge bits (bits 4, 5, 6 en 7)
    // Een bitwise AND met 0xF0 (1111 0000) wist de onderste 4 bits.
    // Daarna schuiven we ze 4 posities naar rechts om een getal tussen 0 en 15 te krijgen.
    return (raw_input & 0xF0) >> 4;
}

int32_t TMP102_LeesMillidegrees(void) {
    uint8_t msb = 0, lsb = 0;

    while(I2C1->STAR2 & I2C_STAR2_BUSY);

    // STAP 1: Selecteer register 0x00
    I2C1->CTLR1 |= I2C_CTLR1_START;
    while(!(I2C1->STAR1 & I2C_STAR1_SB));
    I2C1->DATAR = (TMP102_ADDRESS << 1);
    while(!(I2C1->STAR1 & I2C_STAR1_ADDR));
    (void)I2C1->STAR2;

    I2C1->DATAR = 0x00;
    while(!(I2C1->STAR1 & I2C_STAR1_TXE));

    // STAP 2: Schakel om naar Read-modus
    I2C1->CTLR1 |= I2C_CTLR1_START;
    while(!(I2C1->STAR1 & I2C_STAR1_SB));
    I2C1->DATAR = (TMP102_ADDRESS << 1) | 1;
    while(!(I2C1->STAR1 & I2C_STAR1_ADDR));
    (void)I2C1->STAR2;

    // LEES MSB
    while(!(I2C1->STAR1 & I2C_STAR1_RXNE));
    msb = I2C1->DATAR;

    // Zet NACK en STOP klaar voor de laatste byte
    I2C1->CTLR1 &= ~I2C_CTLR1_ACK;
    I2C1->CTLR1 |= I2C_CTLR1_STOP;

    // LEES LSB
    while(!(I2C1->STAR1 & I2C_STAR1_RXNE));
    lsb = I2C1->DATAR;

    // Herstel ACK voor eigen Slave-modus
    I2C1->CTLR1 |= I2C_CTLR1_ACK;

    // VERWERK NAAR MILLIDEGREES
    int16_t temp_raw = (msb << 4) | (lsb >> 4);
    if (temp_raw & (1 << 11)) {
        temp_raw |= 0xF000; // Sign-extend naar 16-bit signed
    }

    // Door de cast naar (int32_t) verloopt de vermenigvuldiging gegarandeerd overflow-veilig
    return ((int32_t)temp_raw * 625) / 10;
}


// ============================================================================
// NMEA PARSER & HARDWARE INTERRUPT HANDLER
// ============================================================================

void UART1_SendChar(char c) {
    uint32_t start_bit;
    #define DELER_UART      (115200ULL * (1ULL << FILTER_SHIFT))
    // Live berekening van de exacte bit-duur

    uint32_t bit_tijd_gekalibreerd = gemiddelde_seconde_fixed / (uint32_t)DELER_UART;

    __disable_irq();

    // 1. START BIT (LAAG)
    GPIOD->BSHR = (1 << (5 + 16)); 
    start_bit = SysTick->CNT;
    while((SysTick->CNT - start_bit) < bit_tijd_gekalibreerd);

    // 2. DATA BITS (8 stuks, LSB eerst)
    for (uint8_t i = 0; i < 8; i++) {
        if (c & 0x01) {
            GPIOD->BSHR = (1 << 5); 
        } else {
            GPIOD->BSHR = (1 << (5 + 16)); 
        }
        start_bit += bit_tijd_gekalibreerd;
        while((SysTick->CNT - start_bit) < bit_tijd_gekalibreerd);
        c >>= 1;
    }

    // 3. STOP BIT (HOOG)
    GPIOD->BSHR = (1 << 5); 
    start_bit += bit_tijd_gekalibreerd;
    while((SysTick->CNT - start_bit) < bit_tijd_gekalibreerd);
    
    __enable_irq();

    // Korte rustpauze tussen karakters (buiten de kritieke interrupt-lock)
    Delay_us(5);
}
void UART1_SendChar1(char c) {
    // Haal de live berekende, gefilterde seconde-waarde op
    // Stel deze is ~48.000.000 * 64 = 3.072.000.000
    uint32_t tot_ticks = gemiddelde_seconde_fixed;

    // Schakel interrupts uit voor kritieke timing
    __disable_irq();

    // 1. START BIT (LAAG)
    GPIOD->BSHR = (1 << (5 + 16)); 
    uint32_t start_time = SysTick->CNT;
    
    // Wacht tot de startbit voorbij is
    // Wiskunde: (ticks * 1) / (115200 * 64)
    while (((SysTick->CNT - start_time) * 115200ULL * (1ULL << FILTER_SHIFT)) < tot_ticks);

    // 2. DATA BITS (8 stuks, LSB eerst)
    for (uint8_t i = 1; i <= 8; i++) {
        if (c & 0x01) {
            GPIOD->BSHR = (1 << 5); 
        } else {
            GPIOD->BSHR = (1 << (5 + 16)); 
        }
        c >>= 1;

        // Dynamische cumulatieve timing om afrondingsfouten volledig te elimineren!
        // We kijken naar de totale verstreken tijd vanaf de allereerste start_time.
        // Bij bit i moet er in totaal (i + 1) * bit_tijd verstreken zijn.
        uint64_t target_scaled = (uint64_t)tot_ticks * (i + 1);
        while (((uint64_t)(SysTick->CNT - start_time) * 115200ULL * (1ULL << FILTER_SHIFT)) < target_scaled);
    }

    // 3. STOP BIT (HOOG)
    GPIOD->BSHR = (1 << 5); 
    
    // Wacht tot de stopbit voorbij is (in totaal 10 bits aan tijd verstreken vanaf start)
    uint64_t final_target_scaled = (uint64_t)tot_ticks * 10;
    while (((uint64_t)(SysTick->CNT - start_time) * 115200ULL * (1ULL << FILTER_SHIFT)) < final_target_scaled);
    
    // Herstel interrupts
    __enable_irq();

    // Korte rustpauze tussen karakters (buiten de kritieke interrupt-lock)
    Delay_us(5);
}


/*  i2c_config_regs[0x00] |= 0x02;
 * Hardware Interrupt Handler - Verwerkt NMEA op 115200 baud parallel op de achtergrond
 */
void USART1_IRQHandler(void) __attribute__((interrupt("WCH-Interrupt-fast")));
void USART1_IRQHandler(void) {
    uint32_t statr = USART1->STATR;

    // 1. Foutafhandeling (Overrun, Noise, Framing, Parity)
    if (statr & (USART_STATR_ORE | USART_STATR_NE | USART_STATR_FE | USART_STATR_PE)) {
        volatile char dummy = (char)(USART1->DATAR);
        (void)dummy;
        return; 
    }

    // 2. Data ontvangen interrupt
    if (statr & USART_STATR_RXNE) {
        char c = (char)(USART1->DATAR);

        uint16_t offset = active_write_buffer * BUFFER_SIZE_HALF;
        uint16_t *w_ptr = &nmea_write_ptr[active_write_buffer];

        // Wissel van bufferhelft bij een nieuwe '$' (als de vorige RMC-tijd verwerkt is)
        // OF als de buffer bijna vol dreigt te raken (veiligheidsmarge van 20 bytes voor het einde van 650)
        if ((c == '$' && nieuwe_tijd_beschikbaar) || (*w_ptr >= (BUFFER_SIZE_HALF - 20))) {
            
            // Sluit de actieve buffer af en meld dit aan Linux
            buffer_klaar_voor_linux = active_write_buffer;
            bulk_buffer_index = active_write_buffer;
            bulk_buffer_lengte = *w_ptr;

            // Reset de vlag voor de display-parser, zodat we wachten op de VOLGENDE RMC-zin
            nieuwe_tijd_beschikbaar = 0; 

            // Wissel direct naar de andere helft (Ping-Pong)
            active_write_buffer = 1 - active_write_buffer;
            nmea_write_ptr[active_write_buffer] = 0; 
            
            // Herbereken pointers voor de zojuist binnengekomen byte 'c' ($)
            offset = active_write_buffer * BUFFER_SIZE_HALF;
            w_ptr = &nmea_write_ptr[active_write_buffer];
        }

        // Sla de byte VEILIG op binnen de 650 bytes limiet
        if (*w_ptr < BUFFER_SIZE_HALF) {
            nmea_transit_buffer[offset + *w_ptr] = (uint8_t)c;
            (*w_ptr)++;
        }

        // CRUCIAL: Verwijderd! Update NOOIT de bulk_buffer registers bij elke byte.
        // Dit mag puur en alleen tijdens de bovenstaande wisselplaatsvinden om I2C-clashes te voorkomen.


        // =========================================================================
        // DEEL B: Jouw Bestaande NMEA Parser Statemachine (Tijd & Fix extractie)
        // =========================================================================
        if (c == '$') { nmea_state = 1; return; }
        if (nmea_state == 1 && c == 'G') { nmea_state = 2; return; }
        if (nmea_state == 2 && (c == 'P' || c == 'N')) { nmea_state = 3; return; }
        if (nmea_state == 3 && c == 'R') { nmea_state = 4; return; }
        if (nmea_state == 4 && c == 'M') { nmea_state = 5; return; }
        if (nmea_state == 5 && c == 'C') { 
            nmea_state = 6; komma_teller = 0; tijd_index = 0; datum_index = 0; return; 
        }

        if (nmea_state == 6) {
            if (c == ',') {
                komma_teller++;
                if (komma_teller == 10) {
                    nieuwe_tijd_beschikbaar = 1; // RMC-regel succesvol uitgelezen!
                    nmea_state = 0;
                }
                return;
            }

            // [Komma 1]: Tijd (hhmmss)
            if (komma_teller == 1) {
                if (tijd_index < 6) { tijd_buffer[tijd_index] = c; }
                if (tijd_index >= 7) if (c != '0') nmea_state = 0;
                tijd_index++;
            } 
            // [Komma 2]: GPS Status Vlag ('A' = Active / Fix, 'V' = Void / No Fix)
            else if (komma_teller == 2) {
                if (c == 'A') {
                    i2c_config_regs[0x00] &= ~0x02; 
                } 
                else if (c == 'V') {
                    i2c_config_regs[0x00] |= 0x02; 
                }
            }
            // [Komma 9]: Datum (ddmmyy)
            else if (komma_teller == 9) {
                if (datum_index < 6) { datum_buffer[datum_index++] = c; }
            }
        }
    }
}


/* 
 * Genereert en zendt een proprietary NMEA-bericht met live kristal-kalibratiedata
 * Formaat: $PWCHCLK,hele_hz,fractie_mhz,baudrate_index*CS\r\n
 */

void UART1_ZendProprietaryData(void) {
    char body[64];
    uint8_t checksum = 0;
    int idx = 0;
    uint32_t fractie;

    __disable_irq();
    uint32_t lokale_seconde_fixed = gemiddelde_seconde_fixed;
    __enable_irq();

    // Haal de actuele Hz en de mHz fractie direct en zuiver uit je gefilterde waarde
    uint32_t actuele_hz_puur = lokale_seconde_fixed >> FILTER_SHIFT;
    uint32_t hele_hz = actuele_hz_puur;
    
    // Bereken het restant (de fractie) en schaal dit naar millihertz (0..999 mHz)
    uint32_t restant = lokale_seconde_fixed & ((1UL << FILTER_SHIFT) - 1);
    fractie = (restant * 1000UL) >> FILTER_SHIFT;

    // We berekenen het verschil direct op de fixed-komma waarde om sub-Hz precisie te behouden.
    // Pas aan het einde shiften we de FILTER_SHIFT eruit.
//    int64_t nominaal_fixed = (int64_t)NOMINALE_SECONDE_CYCLI << FILTER_SHIFT;
//    int64_t verschil_fixed = (int64_t)gemiddelde_seconde_fixed - nominaal_fixed;

    // Maal 1.000.000 voor PPM (dit past perfect in een int64_t zonder overflow!)
//    int64_t ppm_geschaald = verschil_fixed * 1000000LL;

    // Deel door de nominale waarde ?n pas de bitshift toe (wiskundig samengevoegd)
//    actuele_ppm = (int32_t)((ppm_geschaald / (int64_t)NOMINALE_SECONDE_CYCLI) >> FILTER_SHIFT);

    // 1. Bouw de NMEA proprietary header: POHCLK1
    body[idx++] = 'P'; body[idx++] = 'O'; body[idx++] = 'H';
    body[idx++] = 'C'; body[idx++] = 'L'; body[idx++] = 'K'; body[idx++] = '1';
    body[idx++] = ',';

    // 2. Voeg Hele Hz toe (bijv. 24000120)
    uint32_t temp = hele_hz;
    int start_idx = idx;
    if (temp == 0) {
        body[idx++] = '0';
    } else {
        while (temp > 0) {
            body[idx++] = (temp % 10) + '0';
            temp /= 10;
        }
        for (int i = 0; i < (idx - start_idx) / 2; i++) {
            char t = body[start_idx + i];
            body[start_idx + i] = body[idx - 1 - i];
            body[idx - 1 - i] = t;
        }
    }
    body[idx++] = '.';

    // 3. Voeg Fractie mHz toe met voorloop-nullen (bijv. 045)
    uint32_t schone_fractie = fractie % 1000; // Nu gegarandeerd gevuld!

    body[idx++] = (schone_fractie / 100) + '0';
    body[idx++] = ((schone_fractie % 100) / 10) + '0';
    body[idx++] = (schone_fractie % 10) + '0';
    
    body[idx++] = 'M';
    body[idx++] = 'H';
    body[idx++] = 'z';
    body[idx++] = ',';

    // 4.1 PPM Teken bepalen
    if (actuele_ppm < 0) {
        body[idx++] = '-';
        actuele_ppm = -actuele_ppm; // Maak positief voor cijfer-extractie
    } else {
        body[idx++] = '+';
    }
    
    // 4.2 Extraheer alle cijfers (begrensd tot max 99999 PPM)
    uint32_t ppm_getal = (uint32_t)actuele_ppm % 100000;

    uint8_t c_10000 = ppm_getal / 10000;
    uint8_t c_1000  = (ppm_getal % 10000) / 1000;
    uint8_t c_100   = (ppm_getal % 100) / 100;
    uint8_t c_10    = (ppm_getal % 100) / 10;
    uint8_t c_1     = ppm_getal % 10;

    // 4.3 Voeg de cijfers toe met voorloop-nullen (bijv. +00450)
    body[idx++] = c_10000 + '0';
    body[idx++] = c_1000 + '0';
    body[idx++] = c_100 + '0';
    body[idx++] = c_10 + '0';
    body[idx++] = c_1 + '0';

    body[idx++] = 'P';
    body[idx++] = 'P';
    body[idx++] = 'M';
    body[idx++] = ',';

    // 5. Voeg de actieve Lock-Baudrate Index toe
    body[idx++] = huidige_baudrate_index + '0';
    body[idx++] = ',';

    // 6. Voeg de DIPSW toe
    body[idx++] = dipsw + '0';
    body[idx++] = ',';

    // 7. Voeg de actieve clocksource Index toe
    body[idx++] = freerunning_modus + '0';

    // --- CHECKSUM BEREKENING ---
    for (int i = 0; i < idx; i++) {
        checksum ^= body[i];
    }

    // --- VERZENDING OVER UART (PD5) ---
    UART1_SendChar('$'); 
    for (int i = 0; i < idx; i++) {
        UART1_SendChar(body[i]);
    }
    UART1_SendChar('*'); 
    
    uint8_t high_nibble = (checksum >> 4) & 0x0F;
    uint8_t low_nibble  = checksum & 0x0F;
    UART1_SendChar(high_nibble < 10 ? high_nibble + '0' : high_nibble - 10 + 'A');
    UART1_SendChar(low_nibble < 10 ? low_nibble + '0' : low_nibble - 10 + 'A');
    
    UART1_SendChar('\r');
    UART1_SendChar('\n');
}


/* 
 * Genereert en zendt een geldige $GNRMC zin op basis van de interne kloktijd
 * Formaat: $GNRMC,hhmmss.00,A,5213.1234,N,00510.1234,E,0.0,0.0,220626,,,A*CS\r\n
 */
void UART1_ZendGNRMC(void) {
    char nmea_body[80];
    uint8_t checksum = 0;
    int idx = 0;
    uint8_t nmea_buffer_ptr = 0x20;

    // We bouwen de string handmatig op in een tijdelijke buffer (zonder zware sprintf)
    // De string begint direct NA de '$' voor de checksum berekening
    nmea_body[idx++] = 'G'; nmea_body[idx++] = 'N';
    nmea_body[idx++] = 'R'; nmea_body[idx++] = 'M'; nmea_body[idx++] = 'C';
    nmea_body[idx++] = ',';
    
    // Tijd: hhmmss.00
    nmea_body[idx++] = (interne_uren / 10) + '0';   nmea_body[idx++] = (interne_uren % 10) + '0';
    nmea_body[idx++] = (interne_minuten / 10) + '0'; nmea_body[idx++] = (interne_minuten % 10) + '0';
    nmea_body[idx++] = (interne_seconden / 10) + '0'; nmea_body[idx++] = (interne_seconden % 10) + '0';
    
    nmea_body[idx++] = '.'; nmea_body[idx++] = '0'; nmea_body[idx++] = '0';
    nmea_body[idx++] = ',';
    
    // Status: A = Valid (Geldige fix), V = invalid
//    nmea_body[idx++] = 'A';
    nmea_body[idx++] = freerunning_modus ? 'V': 'A';
    nmea_body[idx++] = ',';
    
    // Fictieve Positie (52°13.12345' N, 005°10.12345' E)
    nmea_body[idx++] = '5'; nmea_body[idx++] = '2'; nmea_body[idx++] = '1'; nmea_body[idx++] = '3';
    nmea_body[idx++] = '.'; nmea_body[idx++] = '1'; nmea_body[idx++] = '2'; nmea_body[idx++] = '3';
    nmea_body[idx++] = '4'; nmea_body[idx++] = '5'; nmea_body[idx++] = ','; nmea_body[idx++] = 'N'; nmea_body[idx++] = ',';
    nmea_body[idx++] = '0'; nmea_body[idx++] = '0'; nmea_body[idx++] = '5'; nmea_body[idx++] = '1';
    nmea_body[idx++] = '0'; nmea_body[idx++] = '.'; nmea_body[idx++] = '1'; nmea_body[idx++] = '2';
    nmea_body[idx++] = '3'; nmea_body[idx++] = '4'; nmea_body[idx++] = '5'; nmea_body[idx++] = ','; nmea_body[idx++] = 'E';
    nmea_body[idx++] = ',';
    
    // Snelheid en koers (0.0, 0.0)
    nmea_body[idx++] = '0'; nmea_body[idx++] = '.'; nmea_body[idx++] = '0'; nmea_body[idx++] = ',';
    nmea_body[idx++] = '0'; nmea_body[idx++] = '.'; nmea_body[idx++] = '0'; nmea_body[idx++] = ',';
    
    // Datum: DDMMYY
    nmea_body[idx++] = (interne_dag / 10) + '0';   nmea_body[idx++] = (interne_dag % 10) + '0';
    nmea_body[idx++] = (interne_maand / 10) + '0'; nmea_body[idx++] = (interne_maand % 10) + '0';
    nmea_body[idx++] = (interne_jaar / 10) + '0'; nmea_body[idx++] = (interne_jaar % 10) + '0';
    nmea_body[idx++] = ',';
    
    nmea_body[idx++] = ',';
    
    // Magnetische variatie (leeg)
    nmea_body[idx++] = ',';
    
    // NMEA 2.3+ Mode indicator: A = Autonomous
    nmea_body[idx++] = freerunning_modus ? 'N': 'A';
    nmea_body[idx++] = ',';
    nmea_body[idx++] = ',';

    // NMEA 4.10 Navigational Status: V =  Not Valid
    nmea_body[idx++] = 'V';

    // --- CHECKSUM BEREKENING ---
    // XOR alle karakters in de buffer met elkaar
    for (int i = 0; i < idx; i++) {
        checksum ^= nmea_body[i];
    }

    nmea_buffer_ptr = 0x20;
    for (int i = 0; i < idx; i++) {
        i2c_config_regs[nmea_buffer_ptr] = nmea_body[i];
        nmea_buffer_ptr++;
        if (nmea_buffer_ptr >= 0x80) {
            nmea_buffer_ptr = 0x20; 
        }
    }



    // --- VERZENDING OVER UART (PD5) ---
    UART1_SendChar('$'); // Startteken (telt niet mee voor checksum) [|]
    
    // Zend de body van de RMC zin
    for (int i = 0; i < idx; i++) {
        UART1_SendChar(nmea_body[i]);
    }
    
    UART1_SendChar('*'); // Checksum scheidingsteken [|]
    
    // Converteer de checksum byte naar 2 hexadecimale ASCII karakters (bijv. 0x4A -> "4A") [|]
    uint8_t high_nibble = (checksum >> 4) & 0x0F;
    uint8_t low_nibble  = checksum & 0x0F;
    
    UART1_SendChar(high_nibble < 10 ? high_nibble + '0' : high_nibble - 10 + 'A');
    UART1_SendChar(low_nibble < 10 ? low_nibble + '0' : low_nibble - 10 + 'A');
    
    // NMEA afsluiter
    UART1_SendChar('\r');
    UART1_SendChar('\n');
}


void Klok_VerwerkGPS(void) {
    nieuwe_tijd_beschikbaar = 0;
    freerunning_modus = 0; 
    laatste_gps_pakket_tijd = SysTick->CNT; 




//        uint32_t actuele_hz_puur = gemiddelde_seconde_fixed >> FILTER_SHIFT;
//    uint32_t hele_hz = actuele_hz_puur;
//    uint32_t restwaarde_filter = gemiddelde_seconde_fixed & ((1 << FILTER_SHIFT) - 1);
//    uint32_t fractie = (restwaarde_filter * 1000) >> FILTER_SHIFT;

//    int32_t hz_afwijking = (int32_t)actuele_hz_puur - (int32_t)NOMINALE_SECONDE_CYCLI;
//    int64_t ppm_lange_berekening = ((int64_t)hz_afwijking * 1000000LL) / (int64_t)NOMINALE_SECONDE_CYCLI;
//    #define PPM_DELER (NOMINALE_SECONDE_CYCLI / 1000000UL)
//    actuele_ppm = (int32_t)ppm_lange_berekening;


    uint8_t gps_u     = ((tijd_buffer[0]  - '0') * 10) + (tijd_buffer[1]  - '0');
    uint8_t gps_m     = ((tijd_buffer[2]  - '0') * 10) + (tijd_buffer[3]  - '0');
    uint8_t gps_s     = ((tijd_buffer[4]  - '0') * 10) + (tijd_buffer[5]  - '0');
    uint8_t gps_dag   = ((datum_buffer[0] - '0') * 10) + (datum_buffer[1] - '0');
    uint8_t gps_maand = ((datum_buffer[2] - '0') * 10) + (datum_buffer[3] - '0');
    uint8_t gps_jaar  = ((datum_buffer[4] - '0') * 10) + (datum_buffer[5] - '0');

    if (gps_u < 24 && gps_m < 60 && gps_s < 60) {
        uint32_t nu_systick = SysTick->CNT;
        if (eerste_sync_gehad) {
            uint32_t werkelijke_cycli = nu_systick - laatste_gps_systick;
            if (werkelijke_cycli >= ONDERGRENS_CYCLI && werkelijke_cycli <= BOVENGRENS_CYCLI) {
                uint64_t huidige_meting_fixed = (uint64_t)werkelijke_cycli << FILTER_SHIFT;
                if (huidige_meting_fixed > gemiddelde_seconde_fixed) {
                    gemiddelde_seconde_fixed += (huidige_meting_fixed - gemiddelde_seconde_fixed) >> FILTER_SHIFT;
                } else {
                    gemiddelde_seconde_fixed -= (gemiddelde_seconde_fixed - huidige_meting_fixed) >> FILTER_SHIFT;
                }

                gecalibreerde_cycli_per_us_fixed = gemiddelde_seconde_fixed / 1000000;
                uint32_t actuele_seconde_cycli = gemiddelde_seconde_fixed >> FILTER_SHIFT;
                int32_t verschil = (int32_t)actuele_seconde_cycli - (int32_t)NOMINALE_SECONDE_CYCLI;
                actuele_ppm = (int32_t)(((int64_t)verschil * 1000000LL) / (int64_t)NOMINALE_SECONDE_CYCLI);



            }
        } else {
            eerste_sync_gehad = 1;
        }
        laatste_gps_systick = nu_systick;

        int8_t lokale_uren = gps_u + tijdzone_offset;
        if (lokale_uren >= 24)      lokale_uren -= 24;
        else if (lokale_uren < 0)  lokale_uren += 24;

        interne_uren = (uint8_t)lokale_uren;
        interne_minuten = gps_m;
        interne_seconden = gps_s;
        interne_dag = gps_dag;
        interne_maand = gps_maand;
        interne_jaar = gps_jaar;

        start_systick_seconde = nu_systick; 

        // Start de PPS-flits synchroon met de GPS
//        GPIOD->BSHR = (1 << (4 + 16)); // PD4 LAAG (Ge?nverteerde LED gaat nu AAN)
        GPIOD->BSHR = (1 << 4); // PD4 HOOG (Ge?nverteerde LED gaat nu UIT)
//        PCF9557_WriteRegister(0x01, 0x00);
        pps_led_start_tijd = SysTick->CNT;
        pps_led_actief = 1;

//        UART1_ZendProprietaryData();
//        UART1_ZendGNRMC();

    }
