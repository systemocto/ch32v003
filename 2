    for (int i = 0; i < sizeof(cmd_set_gsa_1hz); i++) { UART1_SendChar((char)cmd_set_gsa_1hz[i]); } Delay_us(50000);
    for (int i = 0; i < sizeof(cmd_set_gll_1hz); i++) { UART1_SendChar((char)cmd_set_gll_1hz[i]); } Delay_us(50000);
    for (int i = 0; i < sizeof(cmd_set_pps_config); i++) { UART1_SendChar((char)cmd_set_pps_config[i]); } Delay_us(50000);
//    for (int i = 0; i < sizeof(cmd_set_pps_config50); i++) { UART1_SendChar((char)cmd_set_pps_config50[i]); } Delay_us(50000);

    while(1) {
        WDT_Feed();
        if (nieuwe_tijd_beschikbaar) {
            start_systick_frame = SysTick->CNT;
            Klok_VerwerkGPS();
        }

        if (!freerunning_modus && (SysTick->CNT - laatste_gps_pakket_tijd) > TIMEOUT_CYCLI) {
            freerunning_modus = 1; 
        }

        if( freerunning_modus != freerunning_modus_old) {
            if(freerunning_modus) {
                i2c_config_regs[0x00] |= 0x02;
            } else {
                i2c_config_regs[0x00] &= ~0x02;
            }
            freerunning_modus_old = freerunning_modus;
        }


//        if (pps_led_actief && (SysTick->CNT - pps_led_start_tijd) >= 1200000) {
        if (pps_led_actief && (SysTick->CNT - pps_led_start_tijd) >= 2400000) {
//            GPIOD->BSHR = (1 << 4); // PD4 HOOG (Ge?nverteerde LED gaat nu UIT)
            GPIOD->BSHR = (1 << (4 + 16)); // PD4 LAAG (Ge?nverteerde LED gaat nu AAN)
//            PCF9557_WriteRegister(0x01, 0x01);
            pps_led_actief = 0;
        }

        I2C_EEPROM_VerwerkPolling(); // I2C1_EV_IRQHandler
        I2C_EEPROM_SynchroniseerTijd();

        // 3. Update de tijd autonoom elke seconde
        if ((SysTick->CNT - start_systick_seconde) >= (uint32_t)(gemiddelde_seconde_fixed >> FILTER_SHIFT)) {

            tijdzone_offset = (int8_t) i2c_config_regs[0x17];
            if (i2c_config_regs[0x06] == 255) i2c_config_regs[0x06] = 127; // Reset naar 0 offset
            if (i2c_config_regs[0x07] == 255) i2c_config_regs[0x07] = 127; // Reset naar 0 offset

            int32_t mdeg = 1234;
            //mdeg = TMP102_LeesMillidegrees();
            i2c_config_regs[0x1C] = (uint8_t)((mdeg >> 16) & 0xFF); // Hoogste byte (Bits 16-23)
            i2c_config_regs[0x1D] = (uint8_t)((mdeg >> 8)  & 0xFF); // Middelste byte (Bits 8-15)
            i2c_config_regs[0x1E] = (uint8_t)(mdeg         & 0xFF); // Laagste byte  (Bits 0-7)


            if (trigger_flash_write) {
                trigger_flash_write = 0; // Reset de vlag direct
//                Flash_Save_EEPROM_Page(); // Sla de eerste 32 bytes veilig op
            }

            uint8_t i2c_waarde = i2c_config_regs[0x02];
            if (i2c_waarde == 17 /*0x11*/) {
                i2c_config_regs[0x02] = 0; //flash write interval uitgeschakeld
//                Flash_Save_EEPROM_Page();
                flash_write_interval = 0;
            } else if (i2c_waarde > 17) {
                flash_write_interval = 16;
            } else {
                flash_write_interval = i2c_waarde;
            }
        }

        __asm("nop"); 
    }
}
